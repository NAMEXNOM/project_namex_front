// src/app/layout.tsx
'use client'
import { useAuth } from "../../context/AuthContext";
import MainLayout from "../(main)/layout"; // Tu layout con sidebar

export default function RootLayout({ children }) {
  const { user } = useAuth();

  // 1. Si NO hay usuario, solo mostramos children 
  // (Next.js se encargará de mostrar el login si la URL es /login)
  if (!user) {
    return (
      <html>
        <body>
          {children} 
        </body>
      </html>
    );
  }

  // 2. Si SI hay usuario, envolvemos con el MainLayout (Sidebar, etc)
  return (
    <html>
      <body>
        <MainLayout>
          {children}
        </MainLayout>
      </body>
    </html>
  );
}